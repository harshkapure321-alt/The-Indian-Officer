# Copy to .env and fill in. NEVER commit .env.
APP_NAME="The Indian Officer API"
ENVIRONMENT=development

# PostgreSQL. Create the database and user first (see README).
DATABASE_URL=postgresql+psycopg2://tio_user:CHANGE_ME@localhost:5432/tio_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
